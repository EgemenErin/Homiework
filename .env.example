# Copy to .env.local and fill in. For local dev, `npx supabase status -o env` prints the Supabase values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by push notifications and the reminders cron job.
SUPABASE_SECRET_KEY=

# Web push. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron sends this as a Bearer token to /api/cron/reminders
CRON_SECRET=
